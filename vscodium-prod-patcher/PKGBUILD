# shellcheck enable=all shell=bash source-path=SCRIPTDIR
# Maintainer: Ven0m0
# Contributor: fnrir <fnr1r0@protonmail.com>
_pkgname=vscodium-prod-patcher
# Upstream publishes no git tags, so this is packaged from the branch HEAD and
# the version is derived in pkgver() (see the nvchecker `use_commit` entry).
pkgname="$_pkgname-git"
pkgver=r158.f601a5e
pkgrel=1
pkgdesc='Universal patcher for VSCodium product.json (extension marketplace, features, data dir)'
arch=('any')
url='https://github.com/Ven0m0/vscodium-prod-patcher'
license=('GPL-3.0-only')
# mashumaro's TOML mixin needs tomli-w; minipacman imports pyalpm/pycman.
depends=('python' 'pyalpm' 'python-mashumaro' 'python-tomli-w' 'vscodium')
makedepends=('git' 'python-build' 'python-installer' 'python-wheel' 'python-hatchling')
optdepends=('python-inquirer: interactive `config` TUI')
provides=("$_pkgname=${pkgver}")
conflicts=("$_pkgname")
options=('!debug')
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver(){
  cd "$_pkgname" || exit
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build(){
  cd "$_pkgname" || exit
  python -m build --wheel --no-isolation --outdir dist
}

package(){
  cd "$_pkgname" || exit
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  # `hook install` (re)writes /etc/pacman.d/hooks/98-<name>-action.hook from the
  # configured VSCodium packages. Re-run it whenever the patcher itself changes
  # so the generated hook keeps pointing at the current binary and config.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/libalpm/hooks/97-$_pkgname-self.hook" <<EOF
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = $pkgname

[Action]
Description = [$_pkgname] Refreshing VSCodium patch hook
Exec = /usr/bin/$_pkgname hook install
When = PostTransaction
EOF
}

# vim:set sw=2 ts=2 et:
