# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=egl-wayland2
pkgver=v1.0.2
pkgrel=1
pkgdesc="new EGLStream-based Wayland external platform"
url="https://github.com/NVIDIA/egl-wayland2"
arch=(x86_64)
license=(MIT)
depends=(
  eglexternalplatform
  glibc
  libdrm
  wayland
)
makedepends=(
  git
  'libglvnd>=1.3.4'
  meson
  wayland-protocols
)
provides=(libnvidia-egl-wayland2.so)
source=("git+$url#commit=5a2c1cbe0e737cfc3fd89441ab9e40d72c81126e")
b2sums=('17fe1d932b128786916a01831b419978cc7e0e5012a314e8345f8327471410bd3c5868e8c18d36c598d8dfc8929bd47219c759bbdd1a977128d59c509ad1ff03')

prepare() {
  cd "$pkgname" || exit
}

build() {
  arch-meson "$pkgname" build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
#  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 $pkgname/COPYING
}

