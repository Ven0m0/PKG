pkgname=prismlauncher
pkgver=11.1.1
pkgrel=1
pkgdesc="Minecraft launcher with ability to manage multiple instances (optimized)"
arch=('x86_64' 'aarch64')
url='https://prismlauncher.org'
license=('GPL-3.0-only AND LGPL-3.0-or-later AND LGPL-2.0-or-later AND Apache-2.0 AND MIT AND LicenseRef-Batch AND OFL-1.1')
depends=(glibc gcc-libs java-runtime libgl
  qt6-base qt6-5compat qt6-svg qt6-imageformats qt6-networkauth
  quazip-qt6 zlib hicolor-icon-theme tomlplusplus cmark
)
makedepends=('git' 'cmake' 'extra-cmake-modules' 'scdoc' 'ghc-filesystem' 'jdk17-openjdk')
optdepends=('glfw: to use system GLFW libraries'
  'openal: to use system OpenAL libraries'
  'visualvm: Profiling support'
  'xorg-xrandr: for older minecraft versions'
  'java-runtime=8: for older minecraft versions'
  'orca: minecraft screen reader'
  'flite: minecraft voice narration'
  'gamemode: gamemode integragion')
provides=("${pkgname}")
conflicts=("${pkgname}")
source=("prismlauncher-cracked::git+https://github.com/Diegiwg/PrismLauncher-Cracked.git"
        "libnbtplusplus::git+https://github.com/PrismLauncher/libnbtplusplus.git"
        "filesystem::git+https://github.com/gulrak/filesystem.git"
        {lionshead,batch,mdi}.license)
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            '2ee3ba8d96e9882150783b6444651ea4a65d779532ecac8646f2ecd3a48c2770'
            '009e25d32aab6dbae193aac4b82fa1a26cb07f288225b2906da425a0f219bc4c'
            '32646946afc31ef5a4ce2cbb5a5a68a9f552c540a78ef23344c51c3efca58fa6')
b2sums=('SKIP'
        'SKIP'
        'SKIP'
        'be4289832af95b1cd6e721dc16b84a034533de9718d9b43a49bd08dd6fe4e28eaa15228bfb311867b18fddbda1c9fc4c91f04c6d5c1a3bcc39aaa5161425e3ba'
        '356248a6b86f06d260e0920b49d34034f79f9bc504c7fdc1849d929d2ff9b169e693a8269a2c0b34656b3802970d9b8be41a92b35177eaa3c4ccc89a702f5c9d'
        'b35c447cd9223e096a2bb75e0741a7d0a3a1606af54c957e4f276f4e6861a9b3f06ae1d646137e8d2f24ba2238c9967c76eff8cc631a68d7e48e376056982cc6')

prepare() {
    cd PrismLauncher-"$pkgver" || exit
    # Copy git submodules into place
    cp -r "${srcdir}/libnbtplusplus/"* libraries/libnbtplusplus/
    cp -r "${srcdir}/filesystem/"* libraries/filesystem/
    # Fix Java 7 to Java 8 compatibility
    sed -i 's/-target 7 -source 7/-target 8 -source 8/g' libraries/javacheck/CMakeLists.txt
    sed -i 's/-target 7 -source 7/-target 8 -source 8/g' libraries/launcher/CMakeLists.txt
    patch -p1 -i "${startdir}/patches/qfile-open-checks.patch"
}
build() {
  cd PrismLauncher-"$pkgver" || exit
  export PATH="/usr/lib/jvm/java-17-openjdk/bin/:$PATH"
  # Optimized compiler flags
  export CFLAGS="${CFLAGS/-O2/-O3} -pipe -fno-plt"
  export CXXFLAGS="${CXXFLAGS/-O2/-O3} -pipe -fno-plt"

  cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_SKIP_INSTALL_RPATH=YES \
    -DCMAKE_INSTALL_PREFIX="/usr" \
    -DLauncher_BUILD_PLATFORM="archlinux" \
    -DLauncher_QT_VERSION_MAJOR="6" \
    -DLauncher_ENABLE_JAVA_DOWNLOADER=ON \
    -DENABLE_LTO=ON \
    -DBUILD_TESTING=OFF \
    -Bbuild -S. -Wno-dev
  cmake --build build -j"$(nproc)"
}
package() {
  # licenses
  install -Dm644 lionshead.license -t "$pkgdir"/usr/share/licenses/"$pkgname"/
  install -Dm644 batch.license -t "$pkgdir"/usr/share/licenses/"$pkgname"/
  install -Dm644 mdi.license -t "$pkgdir"/usr/share/licenses/"$pkgname"/
  cd PrismLauncher-"$pkgver"/build || exit
  DESTDIR="$pkgdir" cmake --install .
}
