{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md", ".opencode/instructions.md", ".opencode/rules/*.md",
    "https://raw.githubusercontent.com/DietrichGebert/ponytail/main/PONYTAIL.md",
    "https://raw.githubusercontent.com/JuliusBrussee/caveman/main/CAVEMAN.md"
  ],
  "skills": { "paths": [".kilo/skills", ".claude/skills", ".opencode/skills"] },
  "model": "opencode/nemotron-3-ultra-free",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "permission": {
    "*": "allow",
    "sudo *": "deny",
    "rm -rf /": "deny",
    "rm -rf /*": "deny",
    "rm -rf ~": "deny",
    "rm -rf ~/*": "deny",
    ":(){:|:&};:": "deny",
    "doom_loop": "deny",
    "git push --force*": "ask",
    "git push -f*": "ask",
    "git reset --hard*": "ask",
    "git clean -*": "ask",
    "pacman -S*": "ask",
    "makepkg -si*": "ask"
  },
  "disabled_providers": [""],
  "plugin": [
    "opencode-ignore@1.1.0",
    "@bastiangx/opencode-unmoji@0.3.12",
    "opencode-ascii@0.1.8",
    "opencode-agent-skills@0.7.0",
    "@gotgenes/opencode-agent-identity@3.0.1",
    "@dietrichgebert/ponytail@1.0.57",
    "kilo-tools@git+https://github.com/Ven0m0/claude-config.git"
  ],
  "formatter": {
    "shfmt": { "disabled": true },
    "prettier": { "disabled": true }
  },
  "lsp": {
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash"]
    },
    "pyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyw", ".pyi"]
    },
    "yaml-ls": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    },
    "json-ls": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "tombi": {
      "command": ["tombi", "lsp"],
      "extensions": [".toml"]
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".venv/**",
      "**/src/**",
      "**/pkg/**",
      "**/*.pkg.tar.*"
    ]
  },
  "mcp": {
    "ref-tools": {
      "type": "remote",
      "url": "https://api.ref.tools/mcp",
      "enabled": true
    },
    "github-mcp-server": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_search_advanced_exa,get_code_context_exa,crawling_exa",
      "enabled": true
    }
  },
  "compaction": { "auto": true, "prune": true },
  "experimental": {
    "continue_loop_on_deny": false,
    "mcp_timeout": 30000,
    "openTelemetry": false,
    "batch_tool": true
  }
}
